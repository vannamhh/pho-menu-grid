<?xml version="1.0"?>
<ruleset name="Pho Menu Grid">
	<description>WordPress coding standards for the Pho Menu Grid plugin.</description>

	<file>src</file>
	<file>pho-menu-grid.php</file>
	<file>uninstall.php</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!--
			Classes under src/ are PSR-4 autoloaded, so the file name must match
			the class name. That is incompatible with the class-foo.php naming
			these two sniffs enforce.
		-->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- Minimum supported versions. -->
	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="pho-menu-grid"/>
		</properties>
	</rule>
</ruleset>
